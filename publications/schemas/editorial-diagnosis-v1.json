{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papyrus.anth.us/schemas/editorial-diagnosis-v1.json",
  "title": "EditorialDiagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "document_intent",
    "audience",
    "generic_passages",
    "unsupported_claims",
    "repetition_groups",
    "voice_observations",
    "required_facts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "document_intent": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "generic_passages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "voice_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "required_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "repetition_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repetitionGroup"
      }
    },
    "similarity": {
      "$ref": "#/$defs/similarity"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "excerpt", "span", "rationale"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^finding-[a-f0-9]{16}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repetitionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "members", "rationale"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^finding-[a-f0-9]{16}$"
        },
        "kind": {
          "enum": ["redundancy", "concept_restatement"]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "similarity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentenceCount", "clusterCount", "embedder"],
      "properties": {
        "sentenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "clusterCount": {
          "type": "integer",
          "minimum": 0
        },
        "embedder": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
