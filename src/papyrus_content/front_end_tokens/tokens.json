{
  "schemaVersion": 1,
  "note": "The standard front end's design tokens, authored at the sizes people see. Pixels, written once for each layout: compact (under 600 px) and wide (600 px and up). There is no multiplier and no second stylesheet; the build writes rem so the browser's text size still applies. Text sizes below their floor are refused by the linter.",
  "layouts": {
    "compact": {"description": "Phones and narrow windows.", "rhythm": 4},
    "wide": {"description": "600 px and up.", "minWidth": 600, "rhythm": 4}
  },
  "floors": {
    "reading": {"px": 18, "minimumLineRatio": 1.5, "description": "Article, concept and post body, and other long paragraphs."},
    "interface": {"px": 14, "minimumLineRatio": 1.3, "description": "Decks, blurbs, bylines, chips, navigation, captions, form labels and buttons: everything that is not reading text."},
    "label": {"px": 13, "minimumLineRatio": 1.2, "description": "Uppercase and letter-spaced micro-labels. The smallest text anywhere."}
  },
  "text": {
    "display":   {"floor": "reading", "minimumLineRatio": 1.1,   "usage": "A page's one big title: the home lead, an article headline.", "compact": {"size": 36, "line": 40}, "wide": {"size": 56, "line": 64}},
    "headline":  {"floor": "reading", "minimumLineRatio": 1.1,   "usage": "Lead cards and section headings.",                           "compact": {"size": 28, "line": 32}, "wide": {"size": 40, "line": 44}},
    "title":     {"floor": "reading", "minimumLineRatio": 1.1,   "usage": "Card titles.",                                               "compact": {"size": 20, "line": 28}, "wide": {"size": 24, "line": 32}},
    "lede":      {"floor": "interface", "usage": "The line under a headline.",                                 "compact": {"size": 18, "line": 28}, "wide": {"size": 20, "line": 32}},
    "body":      {"floor": "reading",   "usage": "Article and concept text.",                                  "compact": {"size": 18, "line": 28}, "wide": {"size": 20, "line": 32}},
    "interface": {"floor": "interface", "usage": "Buttons, navigation, blurbs.",                               "compact": {"size": 15, "line": 20}, "wide": {"size": 15, "line": 20}},
    "caption":   {"floor": "interface", "usage": "Bylines, captions, dates and metadata.",                     "compact": {"size": 14, "line": 20}, "wide": {"size": 14, "line": 20}},
    "label":     {"floor": "label",     "usage": "Uppercase labels on chips and section tags.",                "compact": {"size": 13, "line": 16}, "wide": {"size": 13, "line": 16}}
  },
  "space": {
    "1": {"compact": 4, "wide": 4}, "2": {"compact": 8, "wide": 8}, "3": {"compact": 12, "wide": 12}, "4": {"compact": 16, "wide": 16},
    "5": {"compact": 20, "wide": 20}, "6": {"compact": 24, "wide": 24}, "8": {"compact": 32, "wide": 32}, "10": {"compact": 40, "wide": 40},
    "12": {"compact": 48, "wide": 48}, "gutter": {"compact": 16, "wide": 48}
  },
  "radius": {"sm": {"compact": 4, "wide": 4}, "md": {"compact": 8, "wide": 8}, "lg": {"compact": 12, "wide": 12}, "xl": {"compact": 16, "wide": 16}},
  "size": {
    "measure": {"compact": 680, "wide": 680, "usage": "Maximum width of running text."},
    "rail-width": {"compact": 280, "wide": 280, "usage": "Width of the article rail."},
    "nav-height": {"compact": 56, "wide": 64, "usage": "Height of the navigation bar."}
  }
}
