{
  "siteId": "p-apyr-us",
  "repository": "https://github.com/AnthusAI/p.apyr.us",
  "brand": "p-apyr-us",
  "frontend": "pretext",
  "aws": { "accountId": "712236451410", "region": "us-east-1" },
  "hostedZoneId": "Z10285921B1G7MVRV06W9",
  "papyrusVersion": "1.0.0-next.1",
  "cms": {
    "domainName": "apyr.us",
    "domainPrefix": "p",
    "stagingDomainPrefix": "p-staging",
    "redirects": [{ "source": "apyr.us", "status": 301 }],
    "cognitoDomainPrefix": "papyrus-p-apyr-us",
    "applyCognitoDomainPrefix": true,
    "environment": {
      "PAPYRUS_EDITION_SLUG": "current",
      "PAPYRUS_ENABLE_CONSOLE_RESPONDER": "false",
      "PAPYRUS_ENABLE_SLACK": "false",
      "PAPYRUS_ENABLE_INBOUND_EMAIL": "false",
      "PAPYRUS_ENABLE_STORAGE_BACKUPS": "true",
      "PAPYRUS_OAUTH_REDIRECT_URLS": "http://localhost:3001/,https://p.apyr.us/,https://p-staging.apyr.us/"
    }
  },
  "github": {
    "owner": "AnthusAI",
    "repo": "p.apyr.us",
    "ciCanDeployInfra": false
  },
  "email": {
    "mode": "existing",
    "sendingDomain": "mail.example.test",
    "configurationSet": "existing-site-email",
    "eventTopicName": "existing-site-email-events"
  }
}
