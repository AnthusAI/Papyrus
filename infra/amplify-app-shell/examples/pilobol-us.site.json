{
  "siteId": "pilobol-us",
  "repository": "https://github.com/AnthusAI/Pilobol.us",
  "brand": "pilobol-us",
  "frontend": "markus-static",
  "aws": {
    "accountId": "712236451410",
    "region": "us-east-1"
  },
  "hostedZoneId": "Z09961547QX1VHIXOBD7",
  "papyrusVersion": "5.42.1",
  "cms": {
    "domainName": "newsroom.pilobol.us",
    "stagingDomainName": "staging.pilobol.us",
    "cognitoDomainPrefix": "papyrus-pilobol-us",
    "buildComputeType": "STANDARD_8GB",
    "environment": {
      "PAPYRUS_EDITION_SLUG": "current",
      "PAPYRUS_ENABLE_CONSOLE_RESPONDER": "false",
      "PAPYRUS_ENABLE_SLACK": "false",
      "PAPYRUS_ENABLE_INBOUND_EMAIL": "false",
      "PAPYRUS_ENABLE_STORAGE_BACKUPS": "false",
      "PAPYRUS_OAUTH_REDIRECT_URLS": "http://localhost:3001/,https://newsroom.pilobol.us/,https://staging.pilobol.us/"
    }
  },
  "reader": {
    "domainName": "pilobol.us",
    "buildCommand": "python3 reader/build.py --content content-export --out dist",
    "baseDirectory": "dist"
  },
  "github": {
    "owner": "AnthusAI",
    "repo": "Pilobol.us",
    "branches": [
      "main",
      "staging"
    ]
  },
  "knowledgeRun": {
    "schedule": "cron(0 9 * * ? *)",
    "siteBucket": "amplify-d1eiwl0gedkmnj-main-bra-sitebucket397a1860-j6tjklhirzk3",
    "edgeDistributionId": "E2GKJ877IAH2I8",
    "redirectsKvsArn": "arn:aws:cloudfront::712236451410:key-value-store/63811e87-4d2d-433d-86ed-2b233baa800c",
    "appSyncApiId": "2tvll2u5ejafbmawb3v2sdonvi",
    "amplifyAppId": "d1eiwl0gedkmnj",
    "contentActionsFunction": "amplify-d1eiwl0gedkmnj-ma-papyruscontentactionsE8B-npf9ha5PkkSG",
    "siteBranch": "main",
    "staticSubdir": "web",
    "monitorSources": [
      "routed"
    ],
    "monitorWeeks": 52,
    "monitorStories": {
      "limit": 3
    },
    "alarmEmailParameter": "/papyrus/shipped/knowledge-run/alarm-email",
    "openAiKeyParameter": "/papyrus/shipped/openai-api-key"
  },
  "email": {
    "mode": "existing",
    "sendingDomain": "mail.example.test",
    "configurationSet": "existing-site-email",
    "eventTopicName": "existing-site-email-events"
  }
}
