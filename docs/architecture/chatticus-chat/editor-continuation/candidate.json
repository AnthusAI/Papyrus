  "cards": [
    {
      "dot": "amber",
      "title": "Proposal, not a verified live flow",
      "items": [
        "Example: check a draft, then approve a consequential action.",
        "The first turn can finish while a long backend job continues.",
        "Approval binds tool arguments, target revision, editor and expiry.",
        "Denied, stale or revoked approval never reaches an execution sink."
      ]
    }
