    },
    {
      "id": "step-13",
      "from": "tools",
      "to": "core",
      "y": 205,
      "label": "Authorized continuation",
      "variant": "security"
    },
    {
      "id": "step-14",
      "from": "core",
      "to": "store",
      "y": 245,
      "label": "Commit result / approval",
      "variant": "default"
    },
    {
      "id": "step-15",
      "from": "editor",
      "to": "api",
      "y": 285,
      "label": "Approve exact action digest",
      "variant": "security"
    },
    {
      "id": "step-16",
      "from": "api",
      "to": "tools",
      "y": 325,
      "label": "Recheck role + revision",
      "variant": "security"
    },
    {
      "id": "step-17",
      "from": "tools",
      "to": "jobs",
      "y": 365,
      "label": "Execute once if authorized",
      "variant": "security"
    },
    {
      "id": "step-18",
      "from": "editor",
      "to": "api",
      "y": 405,
      "label": "Reload + Last-Event-ID",
      "variant": "emphasis"
    },
    {
      "id": "step-19",
      "from": "api",
      "to": "editor",
      "y": 445,
      "label": "Replay / committed result",
      "variant": "return"
