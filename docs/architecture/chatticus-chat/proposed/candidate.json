  "cards": [
    {
      "dot": "cyan",
      "title": "Proposed shared ownership",
      "items": [
        "Chatticus owns protocol, replay reducer, durable runner and chat UI.",
        "Papyrus owns context, permissions, pane placement and background jobs.",
        "No roster, computer, browser or workspace capability in this embed."
      ]
    },
    {
      "dot": "amber",
      "title": "Proposed durability contract",
      "items": [
        "Runner commits events and answers to the same private chat store.",
        "SSE only observes persisted events; closing the pane does not cancel work.",
        "Jobs outlive a turn; completion resumes authorized work or appears on reload."
      ]
