    {
      "id": "step-9",
      "from": "core",
      "to": "store",
      "y": 453,
      "label": "Commit progress + answer",
      "variant": "default"
    },
    {
      "id": "step-10",
      "from": "store",
      "to": "api",
      "y": 485,
      "label": "Read ordered turn events",
      "variant": "return"
    },
    {
      "id": "step-11",
      "from": "api",
      "to": "editor",
      "y": 517,
      "label": "SSE progress / completed",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Proposal, not a verified live flow",
      "items": [
        "Example: check a draft, then approve a consequential action.",
        "The first turn can finish while a long backend job continues.",
        "Approval binds tool arguments, target revision, editor and expiry.",
        "Denied, stale or revoked approval never reaches an execution sink.",
        "Part 2 shows job completion, approval and reload."
      ]
    }
  ]
