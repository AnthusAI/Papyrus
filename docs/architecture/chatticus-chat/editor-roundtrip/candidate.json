      "variant": "default"
    },
    {
      "id": "step-3",
      "from": "api",
      "to": "editor",
      "y": 261,
      "label": "turnId + channelId",
      "variant": "return"
    },
    {
      "id": "step-4",
      "from": "editor",
      "to": "api",
      "y": 293,
      "label": "GET turn SSE + cursor",
      "variant": "emphasis"
    },
    {
      "id": "step-5",
      "from": "core",
      "to": "tools",
      "y": 325,
      "label": "Request editorial check",
      "variant": "default"
    },
    {
      "id": "step-6",
      "from": "tools",
      "to": "jobs",
      "y": 357,
      "label": "Reauthorize; start job",
      "variant": "security"
