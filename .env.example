# Reader runtime. Papyrus reads Amplify GraphQL content by default.
# Fixture scenarios are selected with ?scenario=<id>, not an env toggle.
PAPYRUS_EDITION_SLUG=current
PAPYRUS_BASE_URL=http://localhost:3001
# SSM SecureString parameter name holding the shared secret for POST /api/revalidate (never the value).
# PAPYRUS_REVALIDATE_SECRET_PARAMETER=/papyrus/<siteId>/revalidate-secret
# Public site origin (https, no path). Required in production (Amplify's request URL is localhost:3000); optional under next dev on localhost.
# PAPYRUS_SITE_ORIGIN=https://example.com
# Optional References import via the Cyclotron lab. Origin only (https, no path); unset hides the option.
# Expected shared-lab value: https://o01d28uizl.execute-api.us-east-1.amazonaws.com
# PAPYRUS_CURATION_UPSTREAM_URL=
# PAPYRUS_CURATION_PUBLICATION_ID=<defaults to the site brand id>
PAPYRUS_SITE_BRAND=threat-intelligence
NEXT_PUBLIC_PAPYRUS_SITE_BRAND=threat-intelligence
# Theme packs (ops colors) are selected with the brand. Papyrus is the default
# pack; pilobol-us is the first extra client (aliases: pilobolus, pilobol.us).
# Pilobolus acceptance demo:
# PAPYRUS_SITE_BRAND=pilobol-us
# NEXT_PUBLIC_PAPYRUS_SITE_BRAND=pilobol-us
# Other packs: papyrus | threat-intelligence | pilobol-us

# Local Next.js (`npm run dev`) uses amplify_outputs.json for AppSync/Cognito.
# `npm run dev` runs scripts/ensure-sandbox-amplify-outputs.mjs first so that file
# targets the Ryan sandbox (nkqutx AppSync, pool us-east-1_WD8fuTRVk), not production.
# Optional override when your sandbox stack name differs:
# PAPYRUS_SANDBOX_AMPLIFY_STACK=amplify-papyrus-ryan-sandbox-adcd88a186
#
# Production debugging (~/Projects/Papyrus-production or npm run dev:production):
# Keep production amplify_outputs.json (64hviw AppSync, pool us-east-1_40Uot7WSv).
# PAPYRUS_USE_PRODUCTION_AMPLIFY=1
# PAPYRUS_AMPLIFY_TARGET=production

# Editorial CLI: `papyrus login` uses a reviewed native Google/Cognito client
# and the platform secure store (Keychain, Secret Service, Credential Manager). This path is public metadata, never token material.
# PAPYRUS_CLI_AUTH_CONFIG=/path/to/publication/.papyrus/cli-auth.json
# PAPYRUS_CLI_STATE_DIR=/path/to/private/user-metadata-directory
# Explicit operator lane: PAPYRUS_GRAPHQL_AUTH=iam with the site's authoring role.
# Never put renewable session secrets in this file. See docs/cli-login.md.
PAPYRUS_GRAPHQL_ENDPOINT=

# Use an AWS profile for Amplify sandbox, deploy, and seed commands.
# Example:
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# Amplify backend feature gates (sandbox defaults off unless set explicitly).
# Production main-branch pipeline enables inbound email and storage backups automatically.
# PAPYRUS_ENABLE_INBOUND_EMAIL=true
# PAPYRUS_ENABLE_STORAGE_BACKUPS=true
# PAPYRUS_STORAGE_BACKUP_VAULT_NAME=papyrus-dbsyytcm9drqa-main-media-backup-vault
# PAPYRUS_CONSOLE_RESPONDER_ALLOW_LOCAL_BUILD=true

# Slack agent (sandbox app "Papyrus Sandbox"; use npx ampx sandbox secret set for Lambdas).
# PAPYRUS_ENABLE_SLACK=true
# PAPYRUS_ENABLE_CONSOLE_RESPONDER=true
# PAPYRUS_CONSOLE_RESPONSE_TARGET=cloud
# PAPYRUS_SLACK_SIGNING_SECRET=
# PAPYRUS_SLACK_BOT_TOKEN=
# PAPYRUS_SLACK_ALLOWED_USER_IDS=U01234567

# Inbound SES submission intake (Amplify backend).
# PAPYRUS_INBOUND_EMAIL_DOMAIN=p.apyr.us
# PAPYRUS_INBOUND_EMAIL_LOCAL_PARTS=submissions,suggestions
# PAPYRUS_INBOUND_EMAIL_CORPUS_KEY=threat-intelligence
# PAPYRUS_INBOUND_FEEDBACK_EMAIL_ENABLED=true
# PAPYRUS_INBOUND_FEEDBACK_FROM_EMAIL=Papyrus Submissions <submissions@p.apyr.us>
# Public newsroom links in submission feedback emails (overrides .papyrus/config.yaml publicSite.baseUrl).
# PAPYRUS_PUBLIC_SITE_BASE_URL=https://p.apyr.us

# Directory that holds the Biblicus corpora (corpora/<name>) and is the working directory of
# every Biblicus command. Required by every command that calls Biblicus; there is no default.
# Biblicus itself is the PyPI package installed by `poetry install --extras newsroom`.
# BIBLICUS_WORKDIR=/path/to/biblicus-workdir

# Reference web search (research harness, title/subtitle enrichment).
# Default provider is Tavily; set WEB_SEARCH_PROVIDER=openai to use OpenAI web search.
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# Link exploration (docs/link-exploration.md) falls back to a Tavily search by headline; with no key it records search_unavailable.
# Deployed Lambdas/tasks: PAPYRUS_TAVILY_KEY_PARAMETER=/papyrus/shared/tavily-api-key (SSM SecureString; needs ssm:GetParameter)
#
# Tavily deep research assignments (research.tavily-deep):
#   poetry run papyrus assignments create-research --type research.tavily-deep --title "Topic" ...
#   poetry run papyrus assignments run-tavily-deep-research --assignment <id> --wait
# Optional: --tavily-model auto|mini|pro (default auto on assignment metadata)
# OPENAI_API_KEY=  # still required for LLM calls and when WEB_SEARCH_PROVIDER=openai
#
# Live Tavily integration test (optional):
#   TAVILY_LIVE_TEST=1 PYTHONPATH=src poetry run pytest procedures/newsroom/tests/test_web_search_providers.py -k live
#
# End-to-end dogfood on sandbox (requires AWS credentials + Tavily key):
#   ./scripts/dogfood-tavily-research.sh "Your topic" "search query for Tavily"

# Reference web search (research harness, title/subtitle enrichment).
# Default provider is Tavily; set WEB_SEARCH_PROVIDER=openai to use OpenAI web search.
# WEB_SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# OPENAI_API_KEY=  # still required for LLM calls and when WEB_SEARCH_PROVIDER=openai

# Optional seed editor identity for `npm run seed:amplify`.
# These are app-level credentials created inside Cognito by the seed script.
# Optional seed profile. If set, seed first checks:
#   amplify/seed/profiles/<profile>/seed-edition-content.json
# then falls back to amplify/seed/seed-edition-content.json.
PAPYRUS_SEED_PROFILE=threat-intelligence
PAPYRUS_SEED_USERNAME=papyrus-seed-editor
PAPYRUS_SEED_PASSWORD=change-me
PAPYRUS_SEED_EMAIL=papyrus-seed-editor@example.com

# Reader steering (docs/reader-steering.md). Development and test only: with SITE_ENV=development, a signed-in person
# without a Prospectus siteSubject gets a derived ssdev_ reader id. Never set it in production; 16 or more characters.
# PAPYRUS_READER_DEV_SECRET=

# Strict SES reference receiver only; infra/email assigns these Lambda settings.
# No credentials, sender allowlists or publication grants belong in this file.
# TABLE_NAME=papyrus-monitoring
# EMAIL_MONITOR_ID=email-publication
# EMAIL_RAW_BUCKET=private-submission-bucket
# EMAIL_RAW_PREFIX=email-submissions/
